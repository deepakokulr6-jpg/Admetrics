<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere, except the development backend on the office network
  (plain HTTP) and the Metro bundler on the dev machine. Replace with the
  production HTTPS API before release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.168</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
