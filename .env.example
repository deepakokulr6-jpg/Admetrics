# Admetrics app configuration (read at build time by react-native-dotenv).
# Restart Metro with --reset-cache after changing this file.

# Which backend this build talks to: development | staging | production
APP_ENV=development

# Backend REST API (no trailing slash)
API_BASE_URL=http://192.168.0.168:3000/api
# Give up on a request after this many milliseconds
API_TIMEOUT_MS=15000

# Map tiles (OpenFreeMap, free, no key)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# MOU e-signature (DocuSeal). DEV ONLY: anything here ships inside the app.
# Move signing to the backend before release and leave the key empty.
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_FORM_URL=https://docuseal.com/d/jxecS12SMPrUd5
DOCUSEAL_FORM_SCRIPT=https://cdn.docuseal.com/js/form.js
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_SIGNATURE_FIELD=Signature
