# Admetrics app configuration (read at build time by react-native-dotenv).
# Restart Metro with --reset-cache after changing this file.

# Which backend this build talks to: development | staging | production
APP_ENV=development

# Backend REST API (no trailing slash)
API_BASE_URL=http://192.168.0.165:3000/api
# Give up on a request after this many milliseconds
API_TIMEOUT_MS=15000

# Map tiles (OpenFreeMap, free, no key)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
